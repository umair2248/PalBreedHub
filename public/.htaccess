# Apache config for Hostinger shared hosting (copied into out/ by next build)

ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS and the bare domain (www.palbreedhub.com -> palbreedhub.com)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://palbreedhub.com%{REQUEST_URI} [L,R=301]

# Hashed build assets never change, so cache them for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages and their navigation data: browsers recheck after 5 minutes, the CDN keeps
  # them a day (use "Clear cache" in hPanel after a deploy to show changes at once)
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=300, s-maxage=86400"
  </FilesMatch>
</IfModule>
